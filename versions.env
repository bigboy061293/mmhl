# Pinned upstream sources. Every build script sources this file, so a build
# from the same commit of this repo always pulls the same code.
# All Morse Micro repos below carry the same release tag.

MORSE_RELEASE=mm8108-2.2.3

MORSE_DRIVER_REPO=https://github.com/MorseMicro/morse_driver.git
MORSE_DRIVER_REF=270da4733cd4dc62e78e897746f98f6dfb3bef80      # tag mm8108-2.2.3

MORSE_FIRMWARE_REPO=https://github.com/MorseMicro/morse-firmware.git
MORSE_FIRMWARE_REF=db4b69fd212990c59c5f1712e23060cbb94276ec    # tag mm8108-2.2.3

MORSE_CLI_REPO=https://github.com/MorseMicro/morse_cli.git
MORSE_CLI_REF=f7b9293735e64f4ab99aa9fd75855f7ddbfdcb46         # tag mm8108-2.2.3

MORSE_HOSTAP_REPO=https://github.com/MorseMicro/hostap.git
MORSE_HOSTAP_REF=b1520965c5ae8596725fb4d62e5fd8ab964e580c      # tag mm8108-2.2.3

# Raspberry Pi OS image builder (Trixie, 64-bit)
PIGEN_REPO=https://github.com/RPi-Distro/pi-gen.git
PIGEN_REF=b2cd98a9ee08a31ef7d0110ed09f2492bbd972ec             # tag 2026-10-06-raspios-trixie-arm64

# Morse Micro's OpenWrt fork (ships an RPi 4 + MM8108 board profile)
MORSE_OPENWRT_REPO=https://github.com/MorseMicro/openwrt.git
MORSE_OPENWRT_REF=3.3-dev     # branch; pin to a SHA once a build is known good

# Kernel trees used only by tools/test-compile-driver.sh
RPI_LINUX_REPO=https://github.com/raspberrypi/linux.git
